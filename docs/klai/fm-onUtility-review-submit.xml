<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>The user placed the order (Review &gt; Place Order &gt; runUtilityHook type "submit")</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $$BF_Hook ; "options.type" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$type</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$type = "submit"]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Save the order: Place Order sets $$BF_Model.orderId, or submitError for the page to show</Text>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[""]]></Calculation>
    <Script id="0" name="Place Order"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Get ( ScriptResult )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$placed</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$placed = 1]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Dispatch actions (emails, etc.)</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Clear the cart saved on the user</Text>
  </Step>
  <Step enable="True" id="22" name="Enter Find Mode">
    <Pause state="False"/>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="SelectedLayout"/>
    <Layout id="0" name="BF Users Setup"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["==" & JSONGetElement ( $$BF_User ; "id" )]]></Calculation>
    <Field table="store_BFUsers" id="0" name="id"/>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Get ( FoundCount )]]></Calculation>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["{}"]]></Calculation>
    <Field table="store_BFUsers" id="0" name="cartJSON"/>
  </Step>
  <Step enable="True" id="75" name="Commit Records/Requests">
    <NoInteract state="True"/>
    <Option state="True"/>
    <ESSForceCommit state="False"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="70" name="End If"/>
</fmxmlsnippet>

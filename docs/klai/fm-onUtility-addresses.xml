<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>###########################################################################################</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>CONCERN: onUtilityHook workflow hnadler for addresses</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>PARAMETERS: $$BF_*var - already instantiated</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>RETURNS: save on create sets $$BF_Model payload.newId</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>NOTES:</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>	HookSet Name: addresses</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>	Generator Version: 2024-02-01 3:29:02 AM</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>###########################################################################################</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[List(
       $$BF_Log;
       "@" & Get(ScriptName) & " - Start"
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$$BF_Log</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>---------------------------------------------------------------------------------------</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Klai Address Book: saveAddress sends options.payload { addressName, addressStreet, addressCity, addressProvince, addressPostalZip, addressCountry } and options.id.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>New addresses have a Klai id (local-…); FileMaker creates the record and returns payload.newId. Users only change their own rows (contact_id).</Text>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $$BF_User ; "id" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$userId</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $$BF_Hook ; "options.type" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$type</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $$BF_Hook ; "options.payload" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$payload</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $$BF_Hook ; "options.id" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$id</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[not IsEmpty ( $id ) and Filter ( $id ; "0123456789" ) = $id]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$isRecordId</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $userId )]]></Calculation>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[1]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="SelectedLayout"/>
    <Layout id="363" name="store_BFuser_addresses"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$type = "delete" and $isRecordId]]></Calculation>
  </Step>
  <Step enable="True" id="22" name="Enter Find Mode">
    <Pause state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["==" & $id]]></Calculation>
    <Field table="store_BFuser_addresses" id="9" name="id"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["==" & $userId]]></Calculation>
    <Field table="store_BFuser_addresses" id="32" name="contact_id"/>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Get ( FoundCount ) = 1]]></Calculation>
  </Step>
  <Step enable="True" id="9" name="Delete Record/Request">
    <NoInteract state="True"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="125" name="Else If">
    <Restore state="False"/>
    <Calculation><![CDATA[$type = "save"]]></Calculation>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRecordId]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Edit: only this user's record with this id</Text>
  </Step>
  <Step enable="True" id="22" name="Enter Find Mode">
    <Pause state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["==" & $id]]></Calculation>
    <Field table="store_BFuser_addresses" id="9" name="id"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["==" & $userId]]></Calculation>
    <Field table="store_BFuser_addresses" id="32" name="contact_id"/>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Get ( FoundCount ) <> 1]]></Calculation>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[1]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="69" name="Else"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Create</Text>
  </Step>
  <Step enable="True" id="7" name="New Record/Request"/>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$userId]]></Calculation>
    <Field table="store_BFuser_addresses" id="32" name="contact_id"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[JSONGetElement ( $payload ; "addressName" )]]></Calculation>
    <Field table="store_BFuser_addresses" id="36" name="address_name"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[JSONGetElement ( $payload ; "addressStreet" )]]></Calculation>
    <Field table="store_BFuser_addresses" id="39" name="address_street"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[JSONGetElement ( $payload ; "addressCity" )]]></Calculation>
    <Field table="store_BFuser_addresses" id="40" name="address_city"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[JSONGetElement ( $payload ; "addressProvince" )]]></Calculation>
    <Field table="store_BFuser_addresses" id="41" name="address_province"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[JSONGetElement ( $payload ; "addressPostalZip" )]]></Calculation>
    <Field table="store_BFuser_addresses" id="42" name="address_postal_zip"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[JSONGetElement ( $payload ; "addressCountry" )]]></Calculation>
    <Field table="store_BFuser_addresses" id="43" name="address_country"/>
  </Step>
  <Step enable="True" id="75" name="Commit Records/Requests">
    <NoInteract state="True"/>
    <Option state="True"/>
    <ESSForceCommit state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Klai swaps its temporary local-… id for this one</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( $$BF_Model ; "payload.newId" ; store_BFuser_addresses::id ; JSONString )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$$BF_Model</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>--------------------------- Do not edit below this line -----------------------------</Text>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[1]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
</fmxmlsnippet>

<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>###########################################################################################</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>CONCERN: onUtilityHook workflow hnadler for admintitles</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>PARAMETERS: $$BF_*var - already instantiated</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>RETURNS: save on create sets $$BF_Model payload.newId</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>NOTES:</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>	HookSet Name: admintitles</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>	Generator Version: 2024-01-03 10:22:48 PM</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>	Klai sends only payload { id, title, language } (modelFilterKeys). Empty id = new title.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>###########################################################################################</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[List(
       $$BF_Log;
       "@" & Get(ScriptName) & " - Start"
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$$BF_Log</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>---------------------------------------------------------------------------------------</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $$BF_Hook ; "options.type" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$type</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $$BF_Model ; "payload.id" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$id</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Trim ( JSONGetElement ( $$BF_Model ; "payload.title" ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$title</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[If ( Upper ( JSONGetElement ( $$BF_Model ; "payload.language" ) ) = "FR" ; "FR" ; "EN" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$language</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Klai-only rows (title-…, seed-…) have no FileMaker id</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[not IsEmpty ( $id ) and Filter ( $id ; "0123456789" ) = $id]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$isRecordId</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$type = "save" and not IsEmpty ( $title )]]></Calculation>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="SelectedLayout"/>
    <Layout id="438" name="Titles List"/>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $id )]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Create</Text>
  </Step>
  <Step enable="True" id="7" name="New Record/Request"/>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$title]]></Calculation>
    <Field table="store_titles" id="6" name="title"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$language]]></Calculation>
    <Field table="store_titles" id="7" name="language"/>
  </Step>
  <Step enable="True" id="75" name="Commit Records/Requests">
    <NoInteract state="True"/>
    <Option state="True"/>
    <ESSForceCommit state="False"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( $$BF_Model ; "payload.newId" ; store_titles::id ; JSONNumber )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$$BF_Model</Name>
  </Step>
  <Step enable="True" id="125" name="Else If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRecordId]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Update (rename)</Text>
  </Step>
  <Step enable="True" id="22" name="Enter Find Mode">
    <Pause state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["==" & $id]]></Calculation>
    <Field table="store_titles" id="1" name="id"/>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Get ( FoundCount ) = 1]]></Calculation>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$title]]></Calculation>
    <Field table="store_titles" id="6" name="title"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$language]]></Calculation>
    <Field table="store_titles" id="7" name="language"/>
  </Step>
  <Step enable="True" id="75" name="Commit Records/Requests">
    <NoInteract state="True"/>
    <Option state="True"/>
    <ESSForceCommit state="False"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$type = "delete" and $isRecordId]]></Calculation>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="SelectedLayout"/>
    <Layout id="438" name="Titles List"/>
  </Step>
  <Step enable="True" id="22" name="Enter Find Mode">
    <Pause state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["==" & $id]]></Calculation>
    <Field table="store_titles" id="1" name="id"/>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Get ( FoundCount ) = 1]]></Calculation>
  </Step>
  <Step enable="True" id="9" name="Delete Record/Request">
    <NoInteract state="True"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>--------------------------- Do not edit below this line -----------------------------</Text>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[1]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
</fmxmlsnippet>

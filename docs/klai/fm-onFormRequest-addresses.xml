  <Step enable="True" id="89" name="# (comment)">
    <Text>Required: List of addresses</Text>
  </Step>
  <Step enable="True" id="22" name="Enter Find Mode">
    <Pause state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="False" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $$BF_User ; "id" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$userId</Name>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="SelectedLayout"/>
    <Layout id="363" name="store_BFuser_addresses"/>
  </Step>
  <Step enable="True" id="22" name="Enter Find Mode">
    <Pause state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["==" & JSONGetElement ( $$BF_User ; "id" )]]></Calculation>
    <Field table="store_BFuser_addresses" id="80" name="klai_user_id"/>
  </Step>
  <Step enable="True" id="7" name="New Record/Request"/>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["==" & JSONGetElement ( $$BF_User ; "id" )]]></Calculation>
    <Field table="store_BFuser_addresses" id="32" name="contact_id"/>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="SelectedLayout"/>
    <Layout id="363" name="store_BFuser_addresses"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>DEV ONLY: no Klai users yet, so load every address. REMOVE "Show All Records" before real users log in, or every user sees every user's addresses.</Text>
  </Step>
  <Step enable="True" id="23" name="Show All Records"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["[]"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$addresses</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Get(FoundCount)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$addressCount</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Get(FoundCount)]]></Calculation>
  </Step>
  <Step enable="True" id="16" name="Go to Record/Request/Page">
    <NoInteract state="True"/>
    <RowPageLocation value="First"/>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[store_BFuser_addresses::asJSONsmall]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$address</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Additional Boolean indicators + city / province / postal / country for the Klai Address Book</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement( $address
;	[ "grouped" ; Count( store_BFuser_address_group_link_addresses::active ) ; JSONBoolean ]
;	[ "addressStreet2" ; store_BFuser_addresses::address_street2 ; JSONString ]
;	[ "addressCity" ; store_BFuser_addresses::address_city ; JSONString ]
;	[ "addressProvince" ; store_BFuser_addresses::address_province ; JSONString ]
;	[ "addressPostalZip" ; store_BFuser_addresses::address_postal_zip ; JSONString ]
;	[ "addressCountry" ; store_BFuser_addresses::address_country ; JSONString ]
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$address</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement( $addresses ; Get(RecordNumber) - 1 ; $address ; JSONObject )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$addresses</Name>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[Get(RecordNumber) >= Get(FoundCount)]]></Calculation>
  </Step>
  <Step enable="True" id="16" name="Go to Record/Request/Page">
    <NoInteract state="True"/>
    <Exit state="True"/>
    <RowPageLocation value="Next"/>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( $$BF_Model ;
	[ "addresses" ; $addresses ; JSONArray ];
	[ "addressCount" ; $addressCount ; JSONNumber ];
	[ "groupCount" ; $grouped ; JSONNumber ]
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$$BF_Model</Name>
  </Step>

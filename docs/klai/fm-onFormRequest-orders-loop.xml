<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>$i = next array index: orders without shipping groups are skipped, so Get(RecordNumber) - 1 would leave holes.</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Only orders whose shipping groups saved (Place Order finished). An order with no groups showed as a blank Processing row.</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Count ( store_BFUsers_order_group::id )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( store_BFUsers_order::asJSONsmall ;
  "groups" ; JSON.ArrayFromRelated ( store_BFUsers_order_group::asJSON ) ; JSONArray
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$order</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( $orders ; $i ; $order ; JSONObject )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$orders</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$i + 1]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="16" name="Go to Record/Request/Page">
    <NoInteract state="True"/>
    <Exit state="True"/>
    <RowPageLocation value="Next"/>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
</fmxmlsnippet>
